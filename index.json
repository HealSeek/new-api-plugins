      "usageSchema": {
        "aspect_ratio": {
          "enum": [
            "1:1",
            "16:9",
            "9:16",
            "4:3",
            "3:4",
            "3:2",
            "2:3"
          ],
          "description": {
            "en": "Requested output aspect ratio.",
            "zh": "请求的输出宽高比。"
          }
        },
        "duration": {
          "type": "number",
          "unit": "second",
          "description": {
            "en": "Requested video duration in seconds (1-15).",
            "zh": "请求的视频时长，单位为秒（1-15）。"
          }
        },
        "resolution": {
          "enum": [
            "480p",
            "720p",
            "1080p"
          ],
          "description": {
            "en": "Requested output resolution.",
            "zh": "请求的输出分辨率。"
          }
        }
      },
      "usageExamples": null,
      "usageProfiles": null,
      "channelTypes": [
        48
      ],
